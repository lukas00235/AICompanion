{
  "manifest_version": 3,
  "name": "AI Text Assistant for zav.cz",
  "version": "1.0.0",
  "description": "AI-powered typing assistant that automatically completes Czech typing exercises on zav.cz with customizable speed",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://zav.cz/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://zav.cz/*"],
      "js": ["content-script.js"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Text Assistant",
    "default_icon": {
      "16": "data:image/svg+xml;base64,",
      "32": "data:image/svg+xml;base64,"
    }
  },
  "icons": {
    "16": "data:image/svg+xml;base64,",
    "32": "data:image/svg+xml;base64,",
    "48": "data:image/svg+xml;base64,",
    "128": "data:image/svg+xml;base64,"
  },
  "web_accessible_resources": [
    {
      "resources": ["*"],
      "matches": ["<all_urls>"]
    }
  ]
}
